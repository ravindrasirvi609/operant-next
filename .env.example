# =============================================================================
# UMIS (operant-next) — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# On server start-up, `src/instrumentation.ts` validates these against the
# contract in `src/lib/env.ts` and FAILS FAST with an aggregated report if any
# required variable is missing or malformed.
#
# To bypass validation for a build/CI step without full secrets, set:
#     SKIP_ENV_VALIDATION=1
# Never set that in a running production environment.
# =============================================================================

# --- Core (REQUIRED in every environment) ------------------------------------

# MongoDB connection string used by src/lib/dbConnect.ts
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/umis"

# HS256 signing secret for session JWTs (src/lib/auth/session.ts).
# Must be at least 32 characters. Generate one with:
#     openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"


# --- Admin bootstrap ----------------------------------------------------------
# Shared secret sent as `x-admin-bootstrap-secret` when creating the first admin
# via POST /api/admin/bootstrap. REQUIRED in production; optional in development.
ADMIN_BOOTSTRAP_SECRET=""


# --- Application URL ----------------------------------------------------------
# Absolute base URL used to build links in emails and redirects.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- Email delivery (Resend) --------------------------------------------------
# If RESEND_API_KEY is omitted in development, auth/notification emails are
# logged to the server console as preview links instead of being sent.
# REQUIRED in production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="UMIS <onboarding@resend.dev>"


# --- Cloudflare R2 object storage ---------------------------------------------
# All five variables form an all-or-nothing group. REQUIRED in production
# (uploads, evidence, and photos depend on them). In development you may leave
# them all blank if you are not exercising file features.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
# Public base URL for serving stored objects (server-side accessor).
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
# Same public base URL, exposed to the browser (used by client upload flows).
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"


# --- Observability ------------------------------------------------------------
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"


# --- Security toggles (Phase 2) -----------------------------------------------
# All optional with safe defaults; see docs/21_Security_Hardening.md.

# Double-submit CSRF enforcement in the proxy. Keep "false" until clients send
# the x-csrf-token header (use csrfFetch), then set "true" — staging first.
CSRF_ENFORCE="false"

# Content-Security-Policy mode: "report-only" (default, non-breaking) or "enforce".
CSP_MODE="report-only"

# Legacy Organization.headUserId authorization path. "true" (default) preserves
# current behaviour; set "false" once all orgs have LeadershipAssignment records.
AUTHZ_COMPATIBILITY_MODE="true"
